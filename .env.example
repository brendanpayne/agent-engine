# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------

# Chat completions. Any OpenAI-compatible endpoint works; the default base URL
# targets DeepSeek. Point LLM_BASE_URL elsewhere to use OpenAI, OpenRouter, or a
# local gateway (vLLM, Ollama, LM Studio).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# Vision (image understanding). Optional — omit to disable the vision path.
GEMINI_API_KEY=

# Cloudflare Workers AI: text-to-image and embeddings. Required for
# generate_image and for any semantic search (knowledge base, archive, episodes).
CF_ACCOUNT_ID=
CF_API_KEY=

# Web search (Brave Search API by default). Optional — the web_search tool
# reports itself unavailable when unset.
SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
CONVO_MODEL=deepseek-chat
CRITIQUE_MODEL=deepseek-chat
VISION_MODEL=gemini-2.5-flash
IMAGE_MODEL=black-forest-labs/flux-1-schnell
EMBED_MODEL=baai/bge-base-en-v1.5

# ---------------------------------------------------------------------------
# Router reliability
# ---------------------------------------------------------------------------
LLM_DEFAULT_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
LLM_STREAM_IDLE_TIMEOUT_MS=30000

# Per-1M-token rates used for cost estimation. Defaults match DeepSeek pricing;
# change these if you point LLM_BASE_URL at a different provider.
LLM_RATE_CACHE_HIT=0.028
LLM_RATE_CACHE_MISS=0.28
LLM_RATE_OUTPUT=0.42

# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------
MAX_TOOL_DEPTH=5
STREAMING_ENABLED=true
# Halves the tool budget, caps facts in the prompt, and skips the critique pass.
LOW_BUDGET_MODE=false

# ---------------------------------------------------------------------------
# Context window
# ---------------------------------------------------------------------------
PAST_MESSAGES=15
MAX_API_MESSAGES=30
CHAT_MAX_PROMPT_TOKENS=24000

# ---------------------------------------------------------------------------
# Tiered memory
# ---------------------------------------------------------------------------
SUMMARY_INTERVAL=25
FACTS_INTERVAL=15
TOPIC_UPDATE_INTERVAL=40
MAX_FACTS=25
MAX_SUMMARIES=3
MAX_FACTS_IN_PROMPT=15
FACT_TTL_DAYS=90
FACT_CONFIDENCE_THRESHOLD=2
INCLUDE_CHANNEL_FACTS_IN_PROMPT=true
INCLUDE_USER_FACTS_IN_PROMPT=true
IMMEDIATE_FACTS_ENABLED=true
IMMEDIATE_FACTS_MIN_LENGTH=20
IMMEDIATE_FACTS_DEBOUNCE_MS=30000

# ---------------------------------------------------------------------------
# Archive, episodes, and compaction
# ---------------------------------------------------------------------------
ARCHIVE_RETENTION_DAYS=90
ARCHIVE_MAX_ROWS_PER_CHANNEL=5000
ARCHIVE_COMPACTION_THRESHOLD=1000
EPISODE_RECALL_MIN_SCORE=0.55

# ---------------------------------------------------------------------------
# Job queue
# ---------------------------------------------------------------------------
JOB_TICK_MS=2000
JOB_BATCH_SIZE=5
REMINDER_MAX_ACTIVE_PER_USER=20

# ---------------------------------------------------------------------------
# Rate limits (per user, in-memory)
# ---------------------------------------------------------------------------
IMAGE_GEN_LIMIT=5
IMAGE_GEN_WINDOW=900
TURN_INFLIGHT_TIMEOUT_MS=120000
TURN_BURST_LIMIT=30
TURN_BURST_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# Storage and logging
# ---------------------------------------------------------------------------
MEMORY_DB_PATH=db/memory.sqlite
KB_DB_PATH=db/kb.sqlite
ARCHIVE_DB_PATH=db/archive.sqlite
EPISODES_DB_PATH=db/episodes.sqlite
JOB_DB_PATH=db/jobs.sqlite
EMBED_CACHE_DB_PATH=db/embed_cache.sqlite

DEBUG_LOGGING=false
LOG_TO_FILE=true
LOG_DIR=logs
HTTP_USER_AGENT=agent-engine/1.0
